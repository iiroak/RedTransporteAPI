# Master token for admin routes (required for /admin/*)
# Generate a strong random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
RED_TRANSPORTE_MASTER_TOKEN=

# Database backend: sqlite (default) or mysql
RED_TRANSPORTE_DB_BACKEND=sqlite

# SQLite: defaults to {DATA_DIR}/red_transporte.db (~/.red_transporte/red_transporte.db)
# MySQL/MariaDB: set a mysql:// URL
# RED_TRANSPORTE_DB_URL=mysql://user:password@localhost:3306/red_transporte

# API server
RED_TRANSPORTE_HOST=0.0.0.0
RED_TRANSPORTE_PORT=8000

# Public API settings (used when requests arrive without a token)
RED_TRANSPORTE_PUBLIC_API=true
RED_TRANSPORTE_PUBLIC_IP_RPM=20

# Proxy / load-balancer settings
# Set to true when the service runs behind a trusted reverse proxy (e.g. the
# the reverse proxy tunnel, whose ingress targets 127.0.0.1). Proxy headers
# (CF-Connecting-IP, then X-Forwarded-For) are only trusted when the connection
# comes from an IP in RED_TRANSPORTE_TRUSTED_PROXY_IPS.
# RED_TRANSPORTE_TRUST_PROXY=false
# Comma-separated IPs/CIDRs allowed to supply proxy headers when TRUST_PROXY=true
# RED_TRANSPORTE_TRUSTED_PROXY_IPS=127.0.0.1

# CORS origins (comma-separated). "*" allows all origins (default).
# Example: "https://app.example.com,https://dashboard.example.com"
# RED_TRANSPORTE_CORS_ORIGINS=*

# GTFS data directory (default: ~/.red_transporte)
# RED_TRANSPORTE_DATA_DIR=~/.red_transporte

# GTFS runtime memory behavior
# false = lazy-load GTFS on first GTFS request (lower idle RAM)
# RED_TRANSPORTE_GTFS_EAGER_LOAD=false
# unload GTFS/router from RAM after N seconds idle (0 disables unload)
# RED_TRANSPORTE_GTFS_IDLE_UNLOAD_SECONDS=900
# build RAPTOR router only when /routing/plan is used
# RED_TRANSPORTE_GTFS_ROUTER_LAZY_BUILD=true
# idle sweeper interval in seconds
# RED_TRANSPORTE_GTFS_SWEEP_INTERVAL_SECONDS=60

# iBus scraper settings
# RED_IBUS_URL=http://m.ibus.cl/Servlet
# RED_IBUS_TIMEOUT=15
# RED_IBUS_CACHE_TTL=30

# RED API (MITM-dependent)
# RED_API_BASE_URL=https://appred.tstgo.cl
